#!/usr/bin/env bash
# Read-only SmartLink Manager checks through the workspace's supported PHP runtime.

set -u

PACKAGE_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$PACKAGE_ROOT/../.." 2>/dev/null && pwd -P)"

if [ "$PACKAGE_ROOT" != "$WORKSPACE_ROOT/plugins/smartlink-manager" ] \
    || [ ! -f "$WORKSPACE_ROOT/.ddev/config.yaml" ]; then
    echo "SmartLink Manager pre-commit requires the supported workspace DDEV project." >&2
    echo "No host-PHP fallback is permitted for this hook." >&2
    exit 1
fi

if ! command -v ddev >/dev/null 2>&1; then
    echo "SmartLink Manager is in the workspace, but DDEV is unavailable." >&2
    echo "Install or start DDEV, then retry the commit." >&2
    exit 127
fi

echo "Running SmartLink Manager code quality checks through DDEV..."
(
    cd "$WORKSPACE_ROOT" || exit 1
    ddev exec "cd plugins/smartlink-manager && composer ci"
)
status=$?

if [ "$status" -ne 0 ]; then
    echo "SmartLink Manager pre-commit checks failed in DDEV (exit $status)." >&2
    exit "$status"
fi

echo "SmartLink Manager pre-commit checks passed."
exit 0
